# Docker ignore file - prevent sensitive files from being included in production image

# Environment files - CRITICAL: these should never be in production images
**/.env
**/.env.*
**/*.env
backend/.env
frontend/.env

# Development files
.git/
.gitignore
.dockerignore
*.md
LICENSE

# IDE
.vscode/
.idea/

# Dependencies (will be reinstalled in container)
**/node_modules/
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/

# Test files
**/test_reports/
**/*.test.js
**/*.spec.js
**/coverage/

# Build artifacts that should be rebuilt
**/build/
**/dist/

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Memory/documentation (not needed in production)
memory/

# Large files
**/*.zip
**/*.tar
**/*.tar.gz
